{
  "name": "swgss-army-knife",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --files --quiet src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "tsc --skipLibCheck",
    "ts": "tsc --pretty",
    "clean": "rimraf dist/",
    "test": "cross-env PACT_OVERWRITE=0 jest --runInBand",
    "test:update-pacts": "jest --runInBand",
    "check:env": "node scripts/check-env.js",
    "migration:generate": "bash scripts/with-secrets.sh typeorm migration:generate -d dist/data-source.js src/migrations/init",
    "migrate": "bash scripts/with-secrets.sh typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh typeorm migration:revert -d dist/data-source.js",
    "demo:nplus1": "bash scripts/with-secrets.sh node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh node dist/report.js",
    "seed": "bash scripts/with-secrets.sh node dist/seed.js"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.1.2",
    "@redocly/cli": "^2.46.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.4.3"
  }
}
